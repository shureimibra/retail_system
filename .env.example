# Copy to .env and fill in. Never commit .env.

# Django
DEBUG=True
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave unset to use local SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/retail_system

# Celery / Redis: leave unset in development and tasks run inline (no Redis needed).
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Admin (platform operators only)
ADMIN_URL=ops/

# Messaging. Every channel uses the built-in simulator unless you choose a provider.
# Free set-up steps for each one: docs/setup-free-channels.md
#   WHATSAPP_PROVIDER = simulator | twilio_whatsapp | whatsapp_cloud
#   SMS_PROVIDER      = simulator | twilio | africastalking
#   EMAIL_PROVIDER    = simulator | email
WHATSAPP_PROVIDER=simulator
SMS_PROVIDER=simulator
EMAIL_PROVIDER=simulator
# Public https address of this site (the Cloudflare tunnel while testing). Replies, item photos
# and M-Pesa confirmations need it. Add the tunnel's host to ALLOWED_HOSTS too (.trycloudflare.com).
SITE_URL=http://localhost:8000
# Show Settings > Messaging > Test mode (play the customer). Defaults to DEBUG.
# SIMULATOR_ENABLED=True

# Meta WhatsApp Cloud API (free test number: developers.facebook.com)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved template names (docs/whatsapp-templates.md). Blank = not approved yet: that message goes by SMS.
WHATSAPP_TEMPLATE_RESTOCK_ALERT=
WHATSAPP_TEMPLATE_PRICE_DROP=
WHATSAPP_TEMPLATE_DEPOSIT_RECEIPT=
WHATSAPP_TEMPLATE_REMINDER_1=
WHATSAPP_TEMPLATE_REMINDER_2=
WHATSAPP_TEMPLATE_REMINDER_3=
WHATSAPP_TEMPLATE_CHECK_IN=

# Twilio SMS (free trial: verified numbers only, 30 days)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WhatsApp through Twilio (WHATSAPP_PROVIDER=twilio_whatsapp). Default: Twilio's free WhatsApp Sandbox number.
# TWILIO_WHATSAPP_FROM=+14155238886

# Africa's Talking SMS (free sandbox: username "sandbox"; messages show in their web simulator)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SANDBOX=True
AFRICASTALKING_WEBHOOK_TOKEN=

# Email. Leave EMAIL_HOST blank to print emails to the console.
#   Mailpit (local):   EMAIL_HOST=localhost  EMAIL_PORT=1025
#   Brevo (free plan): EMAIL_HOST=smtp-relay.brevo.com  EMAIL_PORT=587  EMAIL_USE_TLS=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Retail OS <no-reply@localhost>

# M-Pesa (Safaricom Daraja). MPESA_ENV = off | sandbox | production. The sandbox is free (test money only).
MPESA_ENV=off
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Any long random text; it becomes part of the confirmation address so only Safaricom can use it.
MPESA_CALLBACK_TOKEN=
# Leave these unset for the sandbox; set your own for production.
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
