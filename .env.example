# Copy to .env and fill in. Never commit .env.

# Django
DEBUG=True
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave unset to use local SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/retail_system

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Twilio (optional; leave blank to use simulation mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
