# Copy to .env and fill in. Never commit .env.

# Django
DEBUG=True
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave unset to use local SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/retail_system

# Celery / Redis: leave unset in development and tasks run inline (no Redis needed).
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Admin (platform operators only)
ADMIN_URL=ops/

# Messaging. Every channel uses the built-in simulator unless you choose a provider:
#   WHATSAPP_PROVIDER = simulator | whatsapp_cloud | twilio
#   SMS_PROVIDER      = simulator | africastalking | twilio
#   EMAIL_PROVIDER    = simulator | email
WHATSAPP_PROVIDER=simulator
SMS_PROVIDER=simulator
EMAIL_PROVIDER=simulator
# Public address of this site (photo links in WhatsApp messages need it to be reachable).
SITE_URL=http://localhost:8000

# Meta WhatsApp Cloud API (developers.facebook.com, free test number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_RESTOCK=hello_world

# Africa's Talking (free sandbox: username "sandbox")
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SANDBOX=True
AFRICASTALKING_WEBHOOK_TOKEN=

# Email via Mailpit locally (leave EMAIL_HOST blank to print emails to the console)
# EMAIL_HOST=localhost
# EMAIL_PORT=1025

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
